#!/bin/bash

set -aeuo pipefail

# Export CONDADIR to specify alternate conda install path.

# Tools:

bootstrap() {
  local condadir env rootdir
  condadir=$(condadir)
  env=$(env)
  rootdir=$(rootdir)
  if [[ -d $condadir ]]; then
    msg Using existing conda: $condadir
  else
    msg Installing conda to $condadir
    (
      os=$(uname)
      test $os == Darwin && os=MacOSX
      machine=$(uname -m)
      installer=Miniforge3-$os-$machine.sh
      version=26.3.2-3
      curl -sSLO https://github.com/conda-forge/miniforge/releases/download/$version/$installer
      bash $installer -bfp $condadir
      rm -v $installer
      activate base
      conda install --quiet --yes ansible=14.2.*
    )
    msg Installed conda to $condadir
  fi
}

cmd() {
  activate $(env)
  $@
  conda deactivate
}

deploy() {
  local d playbook
  test $# -eq 0 && echo "usage: $(basename $0) ${FUNCNAME[0]} <playbook>" && exit 1
  playbook=$1
  d=$(rootdir)/etc/ansible
  export ANSIBLE_CONFIG=$d/ansible.cfg
  activate base
  ansible-playbook $d/playbooks/$playbook.yaml
}

makedocs() {
  local outdir rootdir
  rootdir=$(rootdir)
  outdir=$rootdir/docs/api
  activate $(env)
  msg Building documentation in $outdir
  export PYTHONWARNINGS="ignore:Error parsing type annotation"
  pdoc --output-dir $outdir $rootdir/lib/aigfs
  conda deactivate
  msg Built documentation in $outdir
}

makeenv() {
  local condadir dir_a dir_d env envdir libdir prefix update
  condadir=$(condadir)
  env=$(env)
  bootstrap
  activate base
  PIP_VERBOSE=1
  XDG_CACHE_HOME=$condadir/cache
  export PIP_VERBOSE XDG_CACHE_HOME
  envdir=$condadir/envs/$env
  if [[ -d $envdir ]]; then
    msg Using existing environment $env
  else
    msg Creating environment $env
    conda env create --file $(envyaml) --quiet --yes
    dir_a=$envdir/etc/conda/activate.d
    dir_d=$envdir/etc/conda/deactivate.d
    mkdir -pv $dir_a $dir_d
    libdir=$(rootdir)/lib
    cat <<EOF >$dir_a/aigfs.sh
if [[ -v PYTHONPATH ]]; then
  export AIGFS_OLD_PYTHONPATH=\$PYTHONPATH
  export PYTHONPATH=$libdir:\$PYTHONPATH
else
  export PYTHONPATH=$libdir
fi
export AIGFS_OLD_PATH=\$PATH
export PATH=$(rootdir)/bin:\$PATH
EOF
    cat <<EOF >$dir_d/aigfs.sh
if [[ -v AIGFS_OLD_PYTHONPATH ]]; then
  export PYTHONPATH=\$AIGFS_OLD_PYTHONPATH
  unset AIGFS_OLD_PYTHONPATH
else
  unset PYTHONPATH
fi
export PATH=\$AIGFS_OLD_PATH
unset AIGFS_OLD_PATH
EOF
    msg Created environment $env
  fi
  while [[ $# -gt 0 ]]; do
    prefix=$1
    shift
    update=$(dirname $(envyaml))/$prefix.yaml
    msg Updating environment $env with $prefix
    conda env update --file $update --name $env --quiet
    msg Updated environment $env with $prefix
  done
  unset PIP_VERBOSE XDG_CACHE_HOME
}

format() {
  activate $(env)
  msg Formatting JSON
  for f in $(jsfiles); do
    jq -S . $f >$f.new || (echo "    in $f" && rm $f.new && false)
    if cmp --quiet $f.new $f; then
      rm $f.new
    else
      mv $f.new $f
    fi
  done
  msg Formatting shell code
  shfmt --indent 2 --write $(shfiles)
  msg Formatting Python code
  ruff format $(pyfiles)
  msg Sorting Python imports
  ruff check --select I --fix $(pyfiles)
  conda deactivate
}

jsfiles() {
  find $(rootdir) -path $(condadir) -prune -o -type f -name "*.json*" -print | sort
}

lint() {
  activate $(env)
  msg Linting YAML
  yamllint --no-warnings $(yamlfiles)
  msg Linting shell code
  shellcheck --format=gcc --severity=info --shell=bash $(shfiles)
  msg Linting Python code
  ruff check $(pyfiles)
  conda deactivate
}

msg() {
  echo "=> $*"
}

pyfiles() {
  find $(rootdir) -path $(condadir) -prune -o -type f -name "*.py" -print | sort
}

rmenv() {
  local env
  env=$(env)
  activate base
  msg Removing environment $env
  conda env remove --name $env --yes
  msg Removed environment $env
}

shfiles() {
  find $(rootdir) -path $(condadir) -prune -o -type f -print | sort | while read -r x; do
    file $x | grep -q "Bourne-Again shell script" && echo $x
  done | sort
}

typecheck() {
  activate $(env)
  msg Typechecking Python code
  MYPYPATH=$(rootdir)/drivers mypy $(pyfiles)
  conda deactivate
}

unittest() {
  activate $(env)
  msg Running Python unit tests
  pytest --cov=aigfs --cov-report=term-missing --ignore=conda/ .
  conda deactivate
}

# Helpers:

activate() {
  local env
  env=$1
  . $(condadir)/etc/profile.d/conda.sh
  CONDARC=$(rootdir)/.condarc
  export CONDARC
  conda activate $env
}

condadir() {
  echo ${CONDADIR:-$(rootdir)/conda}
}

env() {
  sed -n '/^name:.*/ s/^name: *//p' $(envyaml)
}

envyaml() {
  echo $(rootdir)/etc/env/aigfs.yaml
}

fromroot() {
  printf "$(rootdir)/%s " $@
}

rootdir() {
  readlink -f $(dirname $(dirname $0))
}

yamlfiles() {
  find $(rootdir) -path $(condadir) -prune -o -type f -name "*.yaml" -print | sort | grep -v "^.*/aigfs.yaml$"
}

# Main entrypoint:

test $# -eq 0 && echo "usage: $(basename $0) tool [args ...]" && exit 1
tool=$1
shift
$tool $@
